# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/vaad?retryWrites=true&w=majority

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-key-change-in-production
APP_BASE_URL=http://localhost:3000

# File Upload (placeholder for S3/Cloudinary)
UPLOAD_DIR=./public/uploads
MAX_FILE_SIZE=10485760

# Cron & automation
CRON_SECRET=change-me

# Notifications provider control
NOTIFICATIONS_PROVIDER_ENABLED=true

# WhatsApp (optional)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v18.0
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# App Configuration
NODE_ENV=development

# ── Demo credentials visibility ───────────────────────────────────────────────
# Controls whether the demo-account block appears on the login screen.
#
# The block is always shown in local development (NODE_ENV=development).
# In production it is hidden by default.
# Set to "true" only on public demo environments where showing sample credentials
# is intentional (e.g. a staging server you share with prospects).
#
# NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS=true

# ── Email (password reset) ─────────────────────────────────────────────────────
# Resend (https://resend.com) — create a free account, verify your domain,
# then copy the API key from the dashboard.
#
# RESEND_API_KEY   Your Resend API key  (e.g. re_xxxxxxxxxxxx)
# EMAIL_FROM       Verified sender address shown to recipients
#                  Must match a domain verified in your Resend dashboard.
#                  Example:  noreply@vaad.yourcompany.com
# APP_BASE_URL     The public root URL of the app (no trailing slash).
#                  Used to build the password-reset link in emails.
#                  Example:  https://vaad.yourcompany.com
#
# In development: leave RESEND_API_KEY unset to get a safe console fallback
# that prints the reset link to the server log instead of sending a real email.

RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=noreply@yourdomain.com
APP_BASE_URL=https://your-production-url.com

